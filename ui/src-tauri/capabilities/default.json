{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window — allows spawning EchoCompatServer sidecar.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "opener:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/EchoCompatServer",
          "sidecar": true,
          "args": [
            "--host",
            { "validator": "^127\\.0\\.0\\.1$" },
            "--port",
            { "validator": "^\\d{2,5}$" }
          ]
        }
      ]
    }
  ]
}
