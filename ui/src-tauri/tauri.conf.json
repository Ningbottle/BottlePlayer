{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BottleMusic",
  "version": "1.0.0",
  "identifier": "com.bottlemusic.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BottleMusic",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "capabilities": ["default"],
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost http://127.0.0.1:*",
        "script-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob: http: https:",
        "media-src": "'self' blob: http: https: http://127.0.0.1:*",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self' http://localhost:1420",
        "connect-src": "ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420 ws://localhost:1421 http://127.0.0.1:*",
        "script-src": "'self' blob: http://localhost:1420",
        "style-src": "'self' 'unsafe-inline' http://localhost:1420",
        "img-src": "'self' asset: http://asset.localhost data: blob: http: https:",
        "media-src": "'self' blob: http: https: http://127.0.0.1:*",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'",
        "form-action": "'none'"
      },
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "category": "Music",
    "publisher": "Ningbottle",
    "copyright": "Copyright © 2026 Ningbottle",
    "shortDescription": "双皮肤 Windows 音乐播放器",
    "longDescription": "BottleMusic 是面向 Windows 的双皮肤音乐播放器，提供播放队列、歌词、均衡器与本地听歌统计。",
    "homepage": "https://github.com/Ningbottle/BottlePlayer",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "libs/EchoCAPI.dll": "EchoCAPI.dll",
      "libs/sqlite3.dll": "sqlite3.dll"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Ningbottle/BottlePlayer/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM1MUUwNzc1MDIwRjYyREYKUldUZllnOENkUWNlTlh4NFhkU1FLN0s5ajhickpKK3dPQjQ1Qk5ON2VkdG1oVS95RnhQWXNkaUwK"
    }
  }
}
