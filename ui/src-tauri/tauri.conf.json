{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BottleMusic",
  "version": "0.1.0",
  "identifier": "com.bottlemusic.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BottleMusic",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "libs/EchoCAPI.dll": "EchoCAPI.dll"
    },
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Ningbottle/BottlePlayer/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHVwZGF0ZSBleHRlcm5hbCBwdWJsaWMga2V5Ogo1NjgzNjM2NDQyNjE2RTcwNzQ3MjYxNkI2MTczNjUyMDRDMjI3MjZDNUJCNUUwMkEyCklBUXcvN0VJR3FtWU9QYXdoOHh1eFpTQ3pZdlhCTG1PVVZzSkFkS1BEdjNLT0h4d3c9Cg=="
    }
  }
}
